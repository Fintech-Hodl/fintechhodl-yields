                      "type": "integer"
                    },
                    "as_of": {
                      "type": "string"
                    },
                    "captured_at": {
                      "type": "string"
                    },
                    "delay_hours": {
                      "type": "number"
                    },
                    "model_version": {
                      "type": "string"
                    },
                    "disclaimer": {
                      "type": "string"
                    },
                    "item": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "protocol": {
                          "type": "string"
                        },
                        "market": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string"
                        },
                        "apy": {
                          "type": "number",
                          "description": "Percent per year"
                        },
                        "sustainable_apy": {
                          "type": "number",
                          "description": "Percent per year"
                        },
                        "tvl_usd": {
                          "type": "number"
                        },
                        "risk_score": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 100
                        },
                        "opportunity_score": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 100
                        },
                        "confidence": {
                          "type": "number"
                        },
                        "yield_sustainability": {
                          "type": "number"
                        },
                        "liquidity": {
                          "type": "string"
                        },
                        "primary_yield_source": {
                          "type": "string"
                        },
                        "yield_sources": {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        },
                        "major_risks": {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        },
                        "key_dependencies": {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        },
                        "governance_evidence": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "why_this_yield_exists": {
                          "type": "string"
                        },
                        "what_could_lose_money": {
                          "type": "string"
                        },
                        "what_changed_recently": {
                          "type": "string"
                        },
                        "url": {
                          "type": "string"
                        },
                        "data_url": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Unknown id"
          }
        }
      }
    },
    "/.well-known/x402": {
      "servers": [
        {
          "url": "https://intel.fintechhodl.com"
        }
      ],
      "get": {
        "summary": "Every API route with its x402 price",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "429": {
            "description": "Free-route limit reached (60 calls an hour per client)"
          }
        }
      }
    },
    "/api/v1/opportunities": {
      "servers": [
        {
          "url": "https://intel.fintechhodl.com"
        }
      ],
      "get": {
        "summary": "Search and filter all tracked Base opportunities",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Text search"
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Opportunity type"
          },
          {
            "name": "asset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Asset symbol"
          },
          {
            "name": "risk_max",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number"
            },
            "description": "Highest risk score, 0-100"
          },
          {
            "name": "min_apy",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number"
            },
            "description": "Lowest APY, percent"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "At most 100"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "429": {
            "description": "Free-route limit reached (60 calls an hour per client)"
          }
        }
      }
    },
    "/api/v1/yields": {
      "servers": [
        {
          "url": "https://intel.fintechhodl.com"
        }
      ],
      "get": {
        "summary": "Yields screener: quoted APY next to the APY realized on-chain over 7 and 30 days",
        "parameters": [
          {
            "name": "asset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Asset symbol"
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Opportunity type"
          },
          {
            "name": "stable_only",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Only stablecoin principal"
          },
          {
            "name": "realized_only",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Only opportunities with a realized on-chain APY"
          },
          {
            "name": "min_apy",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number"
            },
            "description": "Lowest quoted APY, percent"
          },
          {
            "name": "risk_max",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number"
            },
            "description": "Highest risk score, 0-100"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "risk_adjusted, realized_apy, quoted_apy, sustainable_apy or tvl"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "At most 50"
          }
        ],
        "responses": {
          "200": {
            "description": "OK; the PAYMENT-RESPONSE header carries the settlement receipt",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "402": {
            "description": "Payment required: the PAYMENT-REQUIRED header holds the x402 challenge (price, USDC on Base, pay-to address). Pay and repeat the request."
          },
          "503": {
            "description": "Data is refreshing; nothing is charged"
          }
        }
      }
    },
